#задание 1
R = int(input('Введите радиус круга:'))
pi = 3.14159
S = pi * R**2
print(f'Площадь круга равна {S}')

#задание 2


a = int(input('Введите значение числа a:'))
b = int(input('Введите значение числа b:'))
if a == 0:
    print('Решений нет')
else:
    x = -b / a
    print(f'Значение числа x: {x}')



#задание 3

C = int(input('Введите значение температуры C":'))
F = 95* C +32
print(f'Значение температуры в градусах Фарингейта: {F}')

#Задание 4

a = int(input('Введите значение числа a:'))
b = int(input('Введите значение числа b:'))
c = int(input('Введите значение числа с:'))
A = (a + b +c)/3
print(f'Значение среднего арифмитического трех чисел равно:{A}')

#Задание 5

a = 5 + 2 * 3 - 4/2
print(f'значение первого выражения равно : {a}')
b = (3 + 5)* (2+4)/2
print(f'значение второго выражения равно : {b}')
c = -3 + 6 /  2 * 4
print(f'значение третьего выражения равно : {c}')
d = 5 + 4*5**2+7
print(f'значение четвертого выражения равно : {d}')
